{
  "manifest_version": 3,
  "name": "Chameleon — Accessibility Triage",
  "version": "0.2.0",
  "description": "Chameleon scans the current page locally, triages what blocks the most people first, and tells designers, PMs, and CEOs how to fix it. Not a certification. Runs entirely locally.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Chameleon — triage this page's accessibility",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["widget.css", "assets/icons/icon64.png", "assets/icons/icon96.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
